# Подключение к БД (SQLite через Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Секрет для подписи JWT (задайте длинную случайную строку)
JWT_SECRET="change-me"

# Telegram-бот
TELEGRAM_BOT_TOKEN="your-bot-token"

# Необязательно: username бота для ссылки привязки t.me/<bot>?start=<code>.
# Если не задан, то берётся автоматически через Telegram getMe.
TELEGRAM_BOT_USERNAME=
